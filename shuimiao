name: Build debug APK

on:
  workflow_dispatch:
  push:
    branches: [ main ]

permissions:
  contents: read

concurrency:
  group: apk-${{ github.ref }}
  cancel-in-progress: true

jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v7

      - uses: ./.github/actions/build_setup

      - name: Assemble Free Debug APK
        run: ./gradlew :app:assembleFreeDebug -Pvoice.applicationId=app.timbre.audiobook.mod

      - name: Collect APK
        run: |
          mkdir -p out
          cp app/build/outputs/apk/free/debug/*.apk out/
          ls -lh out

      - uses: actions/upload-artifact@v7
        with:
          name: timbre-mod-apk
          path: out/*.apk
          if-no-files-found: never
